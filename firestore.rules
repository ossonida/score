rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/settings/bgg {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['username'])
        && request.resource.data.username is string && request.resource.data.username.size() > 0 && request.resource.data.username.size() <= 64;
    }
    match /users/{uid}/{kind}/{itemId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid && kind in ['bggCollection','bggPlays'];
      allow create, update: if request.auth != null && request.auth.uid == uid && kind in ['bggCollection','bggPlays']
        && request.resource.data.keys().hasOnly(['id','gameId','name','year','date','quantity','players','username'])
        && request.resource.data.id == itemId && itemId.matches('^[1-9][0-9]{0,19}$')
        && request.resource.data.gameId is string && request.resource.data.gameId.matches('^[1-9][0-9]{0,9}$')
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 300
        && request.resource.data.username is string && request.resource.data.username.size() > 0 && request.resource.data.username.size() <= 64
        && ((kind == 'bggCollection' && request.resource.data.keys().hasAll(['id','gameId','name','username'])
          && request.resource.data.id == request.resource.data.gameId
          && (!('year' in request.resource.data) || request.resource.data.year is string && request.resource.data.year.size() <= 10))
          || (kind == 'bggPlays' && request.resource.data.keys().hasAll(['id','gameId','name','username','date','quantity','players'])
          && request.resource.data.date is string && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.quantity is int && request.resource.data.quantity > 0 && request.resource.data.quantity <= 10000
          && request.resource.data.players is list && request.resource.data.players.size() <= 100));
    }
    match /users/{uid}/plays/{playId} {
      function owns() { return request.auth != null && request.auth.uid == uid; }
      function valid() {
        let p = request.resource.data;
        return p.keys().hasOnly(['id','game','date','rule','location','createdAt','players'])
          && p.keys().hasAll(['id','game','date','rule','createdAt','players'])
          && p.id == playId && p.id is string && p.id.matches('^[A-Za-z0-9_.:-]{1,100}$')
          && p.game is map && p.game.keys().hasOnly(['name','bggId'])
          && p.game.name is string && p.game.name.size() > 0 && p.game.name.size() <= 120
          && p.game.bggId is string && (p.game.bggId == '' || p.game.bggId.matches('^[1-9][0-9]{0,9}$'))
          && p.date is string && p.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && p.createdAt is string && p.createdAt.size() <= 40
          && p.rule in ['highest','lowest','cooperative']
          && (!('location' in p) || p.location is string && p.location.size() <= 120)
          && p.players is list && p.players.size() > 0 && p.players.size() <= 100;
      }
      allow read, delete: if owns();
      allow create, update: if owns() && valid();
    }
  }
}
