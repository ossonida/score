rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/settings/identity {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['primary','aliases'])
        && request.resource.data.keys().hasAll(['primary','aliases'])
        && request.resource.data.primary is string && request.resource.data.primary.size() <= 1000
        && request.resource.data.aliases is list && request.resource.data.aliases.size() <= 100;
    }
    match /users/{uid}/settings/bgg {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['username'])
        && request.resource.data.username is string && request.resource.data.username.size() > 0 && request.resource.data.username.size() <= 64;
    }
    // 종류별 마지막 변경 시각(서버 시각). 기기는 이것만 읽고 바뀐 경우에만 변경분을 받는다.
    match /users/{uid}/settings/sync {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['plays','bggCollection','bggPlays'])
        && (!('plays' in request.resource.data) || request.resource.data.plays is timestamp)
        && (!('bggCollection' in request.resource.data) || request.resource.data.bggCollection is timestamp)
        && (!('bggPlays' in request.resource.data) || request.resource.data.bggPlays is timestamp);
    }
    match /users/{uid}/{kind}/{itemId} {
      allow read, delete: if request.auth != null && request.auth.uid == uid && kind in ['bggCollection','bggPlays'];
      allow create, update: if request.auth != null && request.auth.uid == uid && kind in ['bggCollection','bggPlays']
        && request.resource.data.keys().hasOnly(['id','gameId','name','year','date','quantity','players','username','owned','wishlist','wantToPlay','preordered','numPlays','thumbnail','updatedAt','location','score'])
        && (!('updatedAt' in request.resource.data) || request.resource.data.updatedAt == request.time)
        && request.resource.data.id == itemId && itemId.matches('^[1-9][0-9]{0,19}$')
        && request.resource.data.gameId is string && request.resource.data.gameId.matches('^[1-9][0-9]{0,9}$')
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 300
        && request.resource.data.username is string && request.resource.data.username.size() > 0 && request.resource.data.username.size() <= 64
        && ((kind == 'bggCollection' && request.resource.data.keys().hasAll(['id','gameId','name','username'])
          && request.resource.data.id == request.resource.data.gameId
          && (!('year' in request.resource.data) || request.resource.data.year is string && request.resource.data.year.size() <= 10)
          && (!('owned' in request.resource.data) || request.resource.data.owned is bool)
          && (!('wishlist' in request.resource.data) || request.resource.data.wishlist is bool)
          && (!('wantToPlay' in request.resource.data) || request.resource.data.wantToPlay is bool)
          && (!('preordered' in request.resource.data) || request.resource.data.preordered is bool)
          && (!('numPlays' in request.resource.data) || request.resource.data.numPlays is int && request.resource.data.numPlays >= 0 && request.resource.data.numPlays <= 100000)
          && (!('thumbnail' in request.resource.data) || request.resource.data.thumbnail is string && request.resource.data.thumbnail.size() <= 2048 && request.resource.data.thumbnail.matches('^https://cf[.]geekdo-images[.]com/.*')))
          || (kind == 'bggPlays' && request.resource.data.keys().hasAll(['id','gameId','name','username','date','quantity','players'])
          && request.resource.data.date is string && request.resource.data.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.quantity is int && request.resource.data.quantity > 0 && request.resource.data.quantity <= 10000
          && request.resource.data.players is list && request.resource.data.players.size() <= 100
          && (!('location' in request.resource.data) || request.resource.data.location is string && request.resource.data.location.size() <= 120)
          && (!('score' in request.resource.data) || request.resource.data.score is map && request.resource.data.score.keys().hasOnly(['id','location','note','known']))));
    }
    match /users/{uid}/plays/{playId} {
      function owns() { return request.auth != null && request.auth.uid == uid; }
      function valid() {
        let p = request.resource.data;
        return p.keys().hasOnly(['id','game','date','rule','location','createdAt','players','cooperativeResult','sharedScore','missionAttempts','difficulty','scenario','scenarioLevel','expansions','bggPlayId','sessionId','updatedAt'])
          && (!('updatedAt' in p) || p.updatedAt == request.time)
          && p.keys().hasAll(['id','game','date','rule','createdAt','players'])
          && p.id == playId && p.id is string && p.id.matches('^[A-Za-z0-9_.:-]{1,100}$')
          && p.game is map && p.game.keys().hasOnly(['name','bggId'])
          && p.game.name is string && p.game.name.size() > 0 && p.game.name.size() <= 120
          && p.game.bggId is string && (p.game.bggId == '' || p.game.bggId.matches('^[1-9][0-9]{0,9}$'))
          && p.date is string && p.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && p.createdAt is string && p.createdAt.size() <= 40
          && p.rule in ['highest','lowest','cooperative']
          && (!('cooperativeResult' in p) || p.rule == 'cooperative' && p.cooperativeResult in ['success','failure'])
          && (!('sharedScore' in p) || p.rule == 'cooperative' && p.sharedScore is number && p.sharedScore >= -9007199254740991 && p.sharedScore <= 9007199254740991)
          && (!('missionAttempts' in p) || p.rule == 'cooperative' && 'cooperativeResult' in p && !('sharedScore' in p) && p.missionAttempts is list && p.missionAttempts.size() > 0 && p.missionAttempts.size() <= 300)
          && (!('difficulty' in p) || p.rule == 'cooperative' && 'cooperativeResult' in p && !('missionAttempts' in p) && p.difficulty is string && p.difficulty.size() > 0 && p.difficulty.size() <= 40)
          && (!('scenario' in p) || p.rule == 'cooperative' && 'cooperativeResult' in p && !('missionAttempts' in p) && !('difficulty' in p) && p.scenario is int && p.scenario >= 1 && p.scenario <= 999)
          && (!('scenarioLevel' in p) || 'scenario' in p && p.scenarioLevel is int && p.scenarioLevel >= 0 && p.scenarioLevel <= 7)
          && (!('location' in p) || p.location is string && p.location.size() <= 120)
          && (!('bggPlayId' in p) || p.bggPlayId is string && p.bggPlayId.matches('^[1-9][0-9]{0,19}$'))
          && (!('sessionId' in p) || p.sessionId is string && p.sessionId.matches('^[A-Za-z0-9_-]{1,64}$'))
          && (!('expansions' in p) || p.expansions is list && p.expansions.size() > 0 && p.expansions.size() <= 30)
          && p.players is list && p.players.size() > 0 && p.players.size() <= 100;
      }
      allow read, delete: if owns();
      allow create, update: if owns() && valid();
    }
  }
}
